{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": [
      "es2016",
      "dom",
      "dom.iterable",
      "ES2021.String"
    ],
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": false,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "sourceMap": false,
    "esModuleInterop": true,
    "outDir": "./dist",
    "paths": {
      "*": [
        "./node_modules/*"
      ]
    },
    "types": [
      "jest"
    ],
    "plugins": [
      {
        "transform": "typia/lib/transform"
      }
    ],
    "skipLibCheck": true,
    "strictNullChecks": true
  },
  "include": [
    "src/**/*"
  ]
}